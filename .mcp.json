{
	"mcpServers": {
		"godot-mcp-toolkit": {
			"args": [
				"/c",
				"npx",
				"-y",
				"@npgamedev/godot-mcp-server"
			],
			"command": "cmd",
			"env": {
				"GODOT_MCP_CONFIG_VERSION": "1"
			}
		},
		"codebase-memory-mcp": {
			"args": [
				"/c",
				"npx",
				"-y",
				"codebase-memory-mcp"
			],
			"command": "cmd",
			"env": {
				"CBM_ALLOWED_ROOT": "C:\\Users\\ehort\\Documents\\GODOT PROJECTS"
			}
		}
	}
}
