#!/usr/bin/env python
# Production Ocean query extension: Windows and Linux x86_64.
# Requiere godot-cpp en ../godot-cpp (o GODOT_CPP_PATH) y SCons.
# Uso: python -m SCons platform=windows target=template_release
#
# El descriptor activo (ocean_query_native.gdextension) se genera a partir
# del template SOLO si la librería se compila correctamente. Si el build falla,
# no se crea el descriptor activo (Godot no intenta cargar una DLL inexistente).

import os

godot_cpp_path = ARGUMENTS.get("godot_cpp_path", os.environ.get("GODOT_CPP_PATH", "../godot-cpp"))
env = SConscript(os.path.join(godot_cpp_path, "SConstruct"), {"api_version": "4.7"})

# Sólo nuestros includes; godot-cpp ya configura include/core y include/gen.
env.Append(CPPPATH=["src/"])

# Binario de producción NATIVE DIRECT. Mantener la lista explícita evita que
# prototipos standalone (p. ej. OceanQueryPatchCore de 2C.1A) entren en la DLL
# por accidente al aparecer bajo src/. El benchmark PATCH los compila sólo con
# bench/build_bench_patch.bat.
sources = [
    "src/ocean_query_core.cpp",
    "src/dynamic_ocean_physics_field.cpp",
    "src/dynamic_ocean_async.cpp",
    "src/production_spectrum.cpp",
    "src/ocean_query_native.cpp",
    "src/perf1_capture.cpp",
    "src/perf2_capture.cpp",
    "src/perf2_etw.cpp",
    "src/register_types.cpp",
]

# Keep compiler intermediates out of res:// source folders. Godot otherwise
# treats MSVC .obj files beside the C++ sources as Wavefront OBJ resources.
object_dir = ARGUMENTS.get("object_dir", "build/obj" if env["platform"] == "windows" else os.path.join("build", env["suffix"].lstrip("."), "obj"))
objects = []
for source in sources:
    object_name = os.path.splitext(os.path.basename(source))[0]
    builder = env.Object if env["platform"] == "windows" else env.SharedObject
    objects.append(builder(os.path.join(object_dir, object_name), source))
lite_env = env.Clone()
if env["platform"] == "windows":
    # Worker failure must unwind its completion barrier even when godot-cpp
    # itself was built without C++ exception handling. No arithmetic flags change.
    lite_env.Append(CCFLAGS=["/EHsc"])
else:
    lite_env.Append(CCFLAGS=["-fexceptions"])
lite_builder = lite_env.Object if env["platform"] == "windows" else lite_env.SharedObject
objects.append(lite_builder(os.path.join(object_dir, "dynamic_ocean_lite_async"), "src/dynamic_ocean_lite_async.cpp"))
avx2_env = env.Clone()
if env["platform"] == "windows":
    avx2_env.Append(CCFLAGS=["/arch:AVX2"])
else:
    # Existing SIMD kernels use explicit FMA intrinsics. Keep implicit fusion
    # disabled so ordinary multiply/add expressions retain their operations.
    avx2_env.Append(CCFLAGS=["-mavx2", "-mfma", "-ffp-contract=off"])
avx2_builder = avx2_env.Object if env["platform"] == "windows" else avx2_env.SharedObject
objects.append(avx2_builder(os.path.join(object_dir, "ocean_query_simd_avx2"), "src/ocean_query_simd_avx2.cpp"))
objects.append(avx2_builder(os.path.join(object_dir, "dynamic_ocean_fft_avx2"), "src/dynamic_ocean_fft_avx2.cpp"))

# Nombre canónico de godot-cpp: <base><suffix><SHLIBSUFFIX>, p. ej.
# ocean_query_native.windows.template_release.x86_64.dll
if env["platform"] == "windows":
    env.Append(LIBS=["advapi32"])
elif env["platform"] == "linux":
    env.Append(LINKFLAGS=["-pthread", "-Wl,--no-undefined"])
    env["SHLIBPREFIX"] = ""
library = env.SharedLibrary(
    "{}{}{}".format(ARGUMENTS.get("output_base", "bin/ocean_query_native"), env["suffix"], env["SHLIBSUFFIX"]),
    source=objects,
)
env.NoCache(library)

# Genera el descriptor activo sólo tras compilar la librería.
descriptor = env.Command(
    "ocean_query_native.gdextension",
    ["ocean_query_native.gdextension.template", library],
    Copy("$TARGET", "${SOURCES[0]}"),
)

Default(library, descriptor)
