<?xml version="1.0" encoding="utf-8"?>
<WindowsPerformanceRecorder Version="1.0" Author="Ocean Production">
  <Profiles>
    <SystemCollector Id="Perf2System" Name="Perf2 CPU scheduler">
      <BufferSize Value="256"/><Buffers Value="512"/>
    </SystemCollector>
    <EventCollector Id="Perf2Events" Name="Perf2 game markers">
      <BufferSize Value="64"/><Buffers Value="128"/>
    </EventCollector>
    <SystemProvider Id="Perf2Kernel">
      <Keywords>
        <Keyword Value="ProcessThread"/><Keyword Value="Loader"/>
        <Keyword Value="CSwitch"/><Keyword Value="ReadyThread"/>
        <Keyword Value="SampledProfile"/><Keyword Value="CpuConfig"/>
        <Keyword Value="DPC"/><Keyword Value="Interrupt"/>
      </Keywords>
      <Stacks>
        <Stack Value="SampledProfile"/><Stack Value="CSwitch"/><Stack Value="ReadyThread"/>
      </Stacks>
    </SystemProvider>
    <EventProvider Id="Perf2Markers" Name="a3d2398c-762f-4b16-a89c-61238e641702" Level="5"/>
    <Profile Id="Perf2.Verbose.Memory" Name="Perf2" Description="CPU execution, ready/wait and correlated Godot stage/frame markers" DetailLevel="Verbose" LoggingMode="Memory">
      <Collectors>
        <SystemCollectorId Value="Perf2System"><SystemProviderId Value="Perf2Kernel"/></SystemCollectorId>
        <EventCollectorId Value="Perf2Events"><EventProviders><EventProviderId Value="Perf2Markers"/></EventProviders></EventCollectorId>
      </Collectors>
    </Profile>
  </Profiles>
</WindowsPerformanceRecorder>
