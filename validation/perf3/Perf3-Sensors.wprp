<?xml version="1.0" encoding="utf-8"?>
<WindowsPerformanceRecorder Version="1.0" Author="Ocean Production">
  <Profiles>
    <SystemCollector Id="Perf3System" Name="Perf3 CPU scheduler with external sensors">
      <BufferSize Value="256"/><Buffers Value="512"/>
    </SystemCollector>
    <EventCollector Id="Perf3Events" Name="Perf3 game markers">
      <BufferSize Value="64"/><Buffers Value="128"/>
    </EventCollector>
    <SystemProvider Id="Perf3Kernel">
      <Keywords>
        <Keyword Value="ProcessThread"/><Keyword Value="Loader"/>
        <Keyword Value="CSwitch"/><Keyword Value="ReadyThread"/>
        <Keyword Value="SampledProfile"/><Keyword Value="CpuConfig"/>
        <Keyword Value="DPC"/><Keyword Value="Interrupt"/>
        <Keyword Value="HardFaults"/>
      </Keywords>
      <Stacks><Stack Value="SampledProfile"/><Stack Value="CSwitch"/><Stack Value="ReadyThread"/></Stacks>
    </SystemProvider>
    <EventProvider Id="Perf3Markers" Name="a3d2398c-762f-4b16-a89c-61238e641702" Level="5"/>
    <!-- Explicit companion mode: external sensors supply thermal/power data; no PMU counters requested. -->
    <Profile Id="Perf2.Verbose.Memory" Name="Perf2" Description="PERF-3 sensor companion: native IFFT markers, CPU scheduling and hard faults; no hardware counters" DetailLevel="Verbose" LoggingMode="Memory">
      <Collectors>
        <SystemCollectorId Value="Perf3System"><SystemProviderId Value="Perf3Kernel"/></SystemCollectorId>
        <EventCollectorId Value="Perf3Events"><EventProviders><EventProviderId Value="Perf3Markers"/></EventProviders></EventCollectorId>
      </Collectors>
    </Profile>
  </Profiles>
</WindowsPerformanceRecorder>
