# Godot 4+ specific ignores
.godot/
/android/

# Local persistent code-index cache; never repository source.
/.codebase-memory/

# External pinned checkout bootstrapped locally by validation/physics/setup_native_windows.ps1.
/addons/ocean/physics/native/godot-cpp/

# Regenerable Godot IDs for path-invoked physics validation scripts.
/validation/physics/*.gd.uid
/addons/ocean/physics/phys1_spectrum_adapter.gd.uid

# Godot-generated GLSL import sidecars for validation shaders.
/validation/physics/*.glsl.import
/validation/shaders/*.glsl.import
