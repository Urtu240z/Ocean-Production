#version 450
#extension GL_ARB_gpu_shader_fp64 : require
layout(local_size_x=64) in;
// @OCEAN_AUTHORITY@
// @ENVELOPE_SHARED@
struct Input { vec4 coordinates; uvec4 identity; };
layout(std430,set=0,binding=14) readonly buffer Inputs { Input queries[]; };
layout(std430,set=0,binding=15) writeonly buffer Outputs { vec4 words[]; };
struct ContactState { dvec2 q; dvec2 target; uvec4 owner; uvec4 stamp; vec4 motion; dvec2 vertical; };
layout(std430,set=0,binding=16) buffer ContactStates { ContactState contacts[]; };
struct Control { uvec4 lifetime; vec4 hint; };
layout(std430,set=0,binding=17) readonly buffer Controls { Control controls[]; };
layout(set=1,binding=0) uniform sampler2D atlas_seed;
void main() {
    uint i=gl_GlobalInvocationID.x; if(i>=p.metadata.x) return;
    Input input_value=queries[i]; Control control=controls[i]; ContactState state=contacts[control.lifetime.x];
    uint tile_slot=input_value.identity.y; Tile tile=tiles[tile_slot];
    dvec2 target=input_value.coordinates.xz, q=target;
    double contact_y=input_value.coordinates.y;
    bool same=state.owner==uvec4(input_value.identity.zw,control.lifetime.y,5u)&&state.stamp.x==p.metadata.w;
    bool owned=same&&state.stamp.w!=0u&&(control.lifetime.z&2u)==0u;
    dvec2 previous=owned?state.q:target;
    double previous_y=owned?state.vertical.y:0.0,previous_candidate_y=0.0,maximum_y=-1e30;
    uint iterations=0u,solves=0u,status=4u,reason=0u;
    bool enabled=(control.lifetime.z&1u)!=0u&&finite2(target)&&!isnan(contact_y)&&!isinf(contact_y);
    bool stamp_matches=tile.stamp==uvec4(p.metadata.y,p.metadata.z,p.metadata.w,floatBitsToUint(p.scales_time.z))&&tile.owner.x!=0u&&tile.owner.z==input_value.identity.z&&tile.owner.y==floatBitsToUint(control.hint.z);
    dvec2 uv=(target-dvec2(tile.center_size.xy))/dvec2(tile.center_size.zw)+0.5;
    bool covered=all(greaterThanEqual(uv,dvec2(0)))&&all(lessThan(uv,dvec2(1)));
    int resolution=int(tile.atlas.x),axis=int(tile.atlas.y);
    ivec2 atlas_origin=ivec2(int(tile_slot)%axis,int(tile_slot)/axis)*resolution;
    dvec2 pixel=uv*double(resolution)-0.5; ivec2 lo=ivec2(floor(pixel));
    vec4 seeds[4]; bool ambiguous=false; uint valid_neighbors=0u;
    ivec2 offsets[4]=ivec2[4](ivec2(0),ivec2(1,0),ivec2(0,1),ivec2(1));
    for(int n=0;n<4;n++) {
        ivec2 cell=clamp(lo+offsets[n],ivec2(0),ivec2(resolution-1));
        seeds[n]=texelFetch(atlas_seed,atlas_origin+cell,0);
        if(seeds[n].w>0.5) valid_neighbors++; else ambiguous=true;
    }
    double coherence_radius=max(0.25,4.0*double(max(tile.center_size.z,tile.center_size.w))/double(resolution));
    for(int n=1;n<4;n++) if(length(dvec2(seeds[n].xy-seeds[0].xy))>coherence_radius||abs(seeds[n].z-seeds[0].z)>0.05) ambiguous=true;
    int nearest=(fract(pixel.x)>0.5?1:0)+(fract(pixel.y)>0.5?2:0);
    vec4 atlas_value=seeds[nearest];
    dvec2 candidates[5]; double heights[5]; bool valid_candidates[5];
    for(int n=0;n<5;n++) { valid_candidates[n]=false; heights[n]=-1e30; candidates[n]=target; }
    if(enabled&&stamp_matches&&covered) {
        int count=ambiguous?4:1;
        for(int n=0;n<count;n++) {
            vec4 seed=seeds[(nearest+n)%4]; if(seed.w<0.5) continue;
            dvec2 candidate=seed.xy; uint its,why; solves++;
            bool ok=solve_guarded(target,candidate,target,0.0,0.0,16u,0.000001,0.0,its,why);
            iterations+=its; reason=why;
            dvec3 cd,cv; surface(candidate,cd,cv);
            valid_candidates[n]=ok&&finite2(candidate)&&finite3(cd)&&finite3(cv);
            if(!valid_candidates[n]&&count==1) { ambiguous=true; count=4; }
            candidates[n]=candidate; heights[n]=double(p.domains_sea.w)+cd.y;
            if(valid_candidates[n]) maximum_y=max(maximum_y,heights[n]);
        }
        // Previous q is only a fifth hysteresis candidate at a discontinuity.
        // It cannot turn an empty atlas acquisition into a physical success.
        if(ambiguous&&owned&&maximum_y>-1e29) {
            dvec2 candidate=previous; uint its,why; solves++;
            bool ok=solve_guarded(target,candidate,target,0.0,0.0,16u,0.000001,0.0,its,why);
            iterations+=its; dvec3 cd,cv; surface(candidate,cd,cv);
            valid_candidates[4]=ok&&finite2(candidate)&&finite3(cd)&&finite3(cv);
            candidates[4]=candidate; heights[4]=double(p.domains_sea.w)+cd.y;
            previous_candidate_y=heights[4];
            if(valid_candidates[4]) maximum_y=max(maximum_y,heights[4]);
        }
        int selected=-1;
        for(int n=0;n<5;n++) {
            if(!valid_candidates[n]||heights[n]<maximum_y-0.002) continue;
            if(selected<0||candidates[n].x<candidates[selected].x||(candidates[n].x==candidates[selected].x&&candidates[n].y<candidates[selected].y)) selected=n;
        }
        if(valid_candidates[4]&&heights[4]>=maximum_y-0.002) selected=4;
        if(selected>=0) {
            q=candidates[selected]; reason=0u;
            // Distance classifies continuity, never surface validity/selection.
            double dt=max(0.0,double(p.scales_time.z)-double(state.motion.z));
            double continuity=max(0.02,2.0*length(target-state.target)+2.0*length(state.motion.xy)*dt+0.01);
            status=owned?(selected==4||length(q-previous)<=continuity?1u:5u):3u;
            if(status==5u) reason=8u;
        } else reason=9u;
    } else reason=!enabled?6u:!stamp_matches?10u:11u;
    dvec3 d,v,dx,dz; surface(q,d,v); derivatives(q,dx,dz);
    dvec3 tx=dx+dvec3(1,0,0),tz=dz+dvec3(0,0,1);
    double determinant=tx.x*tz.z-tz.x*tx.z;
    dvec3 normal=cross(tz,tx); normal=length(normal)>1e-12?normalize(normal):dvec3(0,1,0); if(normal.y<0.0) normal=-normal;
    double residual=length(q+d.xz-target);
    double valid=status!=4u&&finite3(d)&&finite3(v)&&finite3(normal)&&finite2(q)&&residual<=p.settings.w?1.0:0.0;
    if(valid<0.5) status=4u;
    contacts[control.lifetime.x].q=valid>0.5?q:(same?state.q:target);
    contacts[control.lifetime.x].target=target;
    contacts[control.lifetime.x].owner=uvec4(input_value.identity.zw,control.lifetime.y,5u);
    contacts[control.lifetime.x].stamp=uvec4(p.metadata.w,p.metadata.z,status,valid>0.5?1u:0u);
    contacts[control.lifetime.x].motion=vec4(v.x,v.z,p.scales_time.z,determinant);
    double surface_y=double(p.domains_sea.w)+d.y;
    contacts[control.lifetime.x].vertical=dvec2(contact_y,surface_y);
    bool compact=p.scales_time.w>0.5; uint ordinary=compact?4u:6u,base=i*(ordinary+7u);
    words[base]=vec4(dvec4(q,residual,double(iterations))); words[base+1u]=vec4(dvec4(d,valid));
    if(compact) { words[base+2u]=vec4(dvec4(v,determinant)); words[base+3u]=vec4(dvec4(normal,valid)); }
    else {
        words[base+2u]=vec4(dvec4(q.x+d.x,p.domains_sea.w+d.y,q.y+d.z,determinant));
        words[base+3u]=vec4(dvec4(v,p.scales_time.z)); words[base+4u]=vec4(dvec4(normal,valid));
        words[base+5u]=uintBitsToFloat(uvec4(p.metadata.y,p.metadata.z,input_value.identity.z,input_value.identity.w));
    }
    words[base+ordinary]=uintBitsToFloat(uvec4(status,solves,reason,owned?1u:0u));
    words[base+ordinary+1u]=vec4(previous,length(q-previous),0);
    words[base+ordinary+2u]=vec4(surface_y,contact_y,surface_y-contact_y,previous_y);
    words[base+ordinary+3u]=vec4(previous_candidate_y,maximum_y,surface_y-previous_y,ambiguous?1.0:0.0);
    words[base+ordinary+4u]=atlas_value;
    words[base+ordinary+5u]=vec4(coverage_bound(),uintBitsToFloat(maxima[12]));
    words[base+ordinary+6u]=vec4(float(tile.stamp.x),float(valid_neighbors),float(tile.owner.y),0);
}
